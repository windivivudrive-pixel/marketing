{
  "name": "creatorflow-remotion-starter",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "lint": "eslint src && tsc",
    "validate": "node scripts/validate-episode.mjs src/data/episode.json src/data/captions.json src/data/words.json --mode production",
    "voice:trim": "node scripts/trim-voice-silence.mjs",
    "qa:cues": "node scripts/render-cue-qa.mjs src/data/episode.json out/cue-qa",
    "build": "remotion bundle",
    "render": "remotion render CreatorFlowVideo out/creatorflow-demo-v01.mp4 --codec=h264 --crf=18 --timeout=120000 --concurrency=2"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.503",
    "@remotion/cli": "4.0.503",
    "@remotion/fonts": "4.0.503",
    "@remotion/install-whisper-cpp": "^4.0.503",
    "@remotion/media": "^4.0.503",
    "@remotion/tailwind-v4": "4.0.503",
    "ffmpeg-static": "^5.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.503",
    "tailwindcss": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.503",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "sideEffects": ["*.css"]
}
